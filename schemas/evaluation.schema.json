{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-systems-fieldbook.example/schemas/evaluation.schema.json",
  "title": "Hardened candidate evaluation record",
  "type": "object",
  "required": [
    "evaluation_schema",
    "evaluator_version",
    "rubric_version",
    "candidate",
    "classification",
    "scores",
    "weighted_score",
    "gates",
    "risks",
    "decision",
    "stealable_mechanism",
    "improvements",
    "verification",
    "archive_target"
  ],
  "properties": {
    "evaluation_schema": {
      "const": "asf-evaluation/v1"
    },
    "evaluator_version": {
      "type": "string"
    },
    "rubric_version": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "candidate": {
      "type": "object"
    },
    "classification": {
      "type": "object"
    },
    "scores": {
      "type": "object",
      "required": [
        "relevance",
        "completeness",
        "actionability",
        "clarity",
        "safety_guardrails",
        "novelty",
        "cross_tool_portability",
        "provenance"
      ],
      "properties": {
        "relevance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "completeness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "actionability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "safety_guardrails": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "novelty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cross_tool_portability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "provenance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      },
      "additionalProperties": false
    },
    "weighted_score": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "gates": {
      "type": "object"
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "disposition",
        "rationale",
        "confidence"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "accept",
            "watch",
            "reject",
            "quarantine"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": true
    },
    "stealable_mechanism": {
      "type": "string",
      "maxLength": 260
    },
    "improvements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object"
    },
    "archive_target": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
